rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for auth verification and role access
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'S Admin' ||
        request.auth.token.admin == true
      );
    }

    function isTeacher(teacherId) {
      return isOwner(teacherId) || isAdmin();
    }

    // ----------------------------------------------------
    // Teachers & Course Management (Hybrid & Offline Compatible)
    // ----------------------------------------------------
    match /teachers/{teacherId} {
      allow read, write: if true; // Public directory & self-contained teacher accounts

      // Subcollections owned by teacher
      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // Central Teacher Codes Registry
    match /teacher_codes/{codeId} {
      allow read, write: if true;
    }

    // Users collection for cross-profile syncing
    match /users/{userId} {
      allow read, write: if true;
    }

    // ----------------------------------------------------
    // Students Profiles & Progress
    // ----------------------------------------------------
    match /students/{studentId} {
      allow read: if true;
      allow create: if true; // Allows self-signup & initial profile creation
      allow update: if isAuthenticated() || true;
      allow delete: if isAdmin();

      // Student Course Access & Entitlements
      match /courseAccess/{courseId} {
        allow read: if true;
        allow write: if isAuthenticated() || true;
      }

      // Student Course Collection Access
      match /courseCollectionAccess/{collectionId} {
        allow read: if true;
        allow write: if isAuthenticated() || true;
      }

      // Watch History
      match /watchHistory/{historyId} {
        allow read: if isOwner(studentId) || true;
        allow write: if isAuthenticated() || true;
      }

      // Notifications targeted to this student
      match /notifications/{notifId} {
        allow read: if isOwner(studentId) || true;
        allow write: if isAuthenticated() || true;
      }
    }

    // Minimal sync data for students & parents
    match /studentSyncData/{barcodeId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    // ----------------------------------------------------
    // System Broadcast Notifications & Announcements
    // ----------------------------------------------------
    match /notifications/{notifId} {
      allow read: if true;
      allow create, update: if isAuthenticated() || true;
      allow delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read, write: if true;
    }

    match /featuredCourses/{courseId} {
      allow read, write: if true;
    }

    // ----------------------------------------------------
    // Academic Content: Quizzes, Question Banks & Tests
    // ----------------------------------------------------
    match /tests/{testId} {
      allow read, write: if true;
    }

    match /testAttempts/{attemptId} {
      allow read, write: if true;
    }

    match /questionBanks/{questionId} {
      allow read, write: if true;
    }

    // ----------------------------------------------------
    // Library, Gamification & Theming
    // ----------------------------------------------------
    match /library_requests/{requestId} {
      allow read, write: if true;
    }

    match /library_themes/{themeId} {
      allow read, write: if true;
    }

    match /rewards/{rewardId} {
      allow read, write: if true;
    }

    match /seasons/{seasonId} {
      allow read, write: if true;
    }

    match /subjects/{subjectId} {
      allow read, write: if true;
    }

    match /assistants/{assistantId} {
      allow read, write: if true;
    }

    // ----------------------------------------------------
    // Educational Centers & Hubs (One-Way Smart Push compatible)
    // ----------------------------------------------------
    match /hubs/{hubId} {
      allow read, write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // Default safety catch-all
    match /{document=**} {
      allow read: if isAuthenticated() || true;
      allow write: if isAuthenticated() || isAdmin();
    }
  }
}
