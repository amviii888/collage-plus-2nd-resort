{
	"appId": "com.mol5saty.app",
	"appName": "Mol5saty",
	"webDir": "out",
	"server": {
		"url": "https://collage-plus-2nd-resort.vercel.app/",
		"cleartext": false,
		"allowNavigation": [
			"collage-plus-2nd-resort.vercel.app",
			"*.vercel.app",
			"*.run.app",
			"*.firebaseapp.com",
			"*.googleapis.com",
			"accounts.google.com"
		]
	},
	"backgroundColor": "#09090b",
	"ios": {
		"contentInset": "always",
		"preferredContentMode": "mobile",
		"scheme": "Mol5saty",
		"allowsLinkPreview": false,
		"scrollEnabled": true,
		"limitsNavigationsToAppBoundDomains": true
	},
	"android": {
		"allowMixedContent": false,
		"captureInput": true,
		"webContentsDebuggingEnabled": false,
		"backgroundColor": "#09090b"
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 2000,
			"launchAutoHide": true,
			"backgroundColor": "#09090b",
			"androidSplashResourceName": "splash",
			"androidScaleType": "CENTER_CROP",
			"showSpinner": true,
			"spinnerColor": "#22c55e",
			"splashFullScreen": true,
			"splashImmersive": true
		},
		"StatusBar": {
			"style": "DARK",
			"backgroundColor": "#09090b"
		},
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		},
		"PrivacyScreen": {
			"enable": true,
			"iosBlur": "dark",
			"image": "splash",
			"protected": true
		}
	},
	"packageClassList": [
		"CAPCameraPlugin",
		"CAPNetworkPlugin",
		"PrivacyScreenPlugin",
		"PushNotificationsPlugin",
		"SplashScreenPlugin",
		"StatusBarPlugin"
	]
}
