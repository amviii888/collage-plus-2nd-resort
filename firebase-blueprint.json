
{
  "entities": {
    "Teacher": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Teacher",
      "type": "object",
      "description": "Represents a teacher and their profile information.",
      "properties": {
        "teacherId": { "type": "string", "description": "Unique identifier for the Teacher entity, same as Firebase Auth UID." },
        "name": { "type": "string", "description": "The teacher's full name." },
        "email": { "type": "string", "description": "The teacher's email address.", "format": "email" },
        "phoneNumber": { "type": "string", "description": "The teacher's publicly visible contact phone number." },
        "profilePictureUrl": { "type": "string", "description": "URL of the teacher's profile picture from Cloudinary.", "format": "uri" },
        "heroImageUrl": { "type": "string", "description": "URL of the teacher's hero image.", "format": "uri" },
        "bio": { "type": "string", "description": "A short biography of the teacher." },
        "subjects": { "type": "array", "description": "An array of subjects taught by the teacher.", "items": { "type": "string" } },
        "gradesTaught": { "type": "array", "description": "An array of grades taught by the teacher.", "items": { "type": "string" } },
        "assistantCode": { "type": "string", "description": "A unique code generated by the teacher for their assistant to log in." },
        "approved": { "type": "boolean", "description": "Admin approval status. Teacher is not active until this is true." },
        "approvalExpiresAt": { "type": "string", "format": "date-time", "description": "If set, the teacher's approval will expire at this time." },
        "paymentDueDate": { "type": "string", "format": "date-time", "description": "The date the teacher's next subscription payment is due." },
        "isFeatured": { "type": "boolean", "description": "Indicates if the teacher is a featured top teacher, managed by an admin." },
        "ratingCount": { "type": "number", "description": "The total number of ratings the teacher has received." },
        "totalRating": { "type": "number", "description": "The sum of all ratings received." },
        "averageRating": { "type": "number", "description": "The calculated average rating (totalRating / ratingCount)." },
        "viewCount": { "type": "number", "description": "The number of unique profile views." },
        "codeUsage": {
            "type": "object",
            "description": "Tracks daily share code generation usage and limits.",
            "properties": {
                "date": { "type": "string", "description": "The date of usage tracking, in YYYY-MM-DD format." },
                "count": { "type": "number", "description": "Number of codes generated on this date." },
                "limit": { "type": "number", "description": "The total daily limit of codes." },
                "extraRequested": { "type": "boolean", "description": "Whether an extra code allotment has been requested for this date." }
            }
        }
      },
      "required": ["teacherId", "name", "email", "approved"]
    },
    "TeacherRating": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "TeacherRating",
      "type": "object",
      "description": "Represents a single rating given by a student to a teacher.",
      "properties": {
        "rating": { "type": "number", "description": "The rating value (e.g., 1-5)." },
        "createdAt": { "type": "string", "format": "date-time", "description": "The timestamp when the rating was given." }
      },
      "required": ["rating", "createdAt"]
    },
    "Student": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Student",
      "type": "object",
      "description": "Represents a student and their profile information, including enrollment details.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the Student entity (same as anon Auth UID)." },
        "name": { "type": "string", "description": "The student's full name." },
        "phoneNumber": { "type": "string", "description": "The student's phone number. This also serves as their password." },
        "age": { "type": "number", "description": "The student's age." },
        "parentPhoneNumber": { "type": "string", "description": "The phone number of the student's parent or guardian." },
        "schoolName": { "type": "string", "description": "The name of the student's school." },
        "grade": { "type": "string", "description": "The student's grade level." },
        "barcodeId": { "type": "string", "description": "The student's self-selected unique check-in ID." },
        "notes": { "type": "string" },
        "message": { 
            "type": "object", 
            "properties": {
                "text": { "type": "string" },
                "from": { "type": "string" }
            }
        },
        "activeSubscriptions": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "subscriptionId": { "type": "string" },
                    "planId": { "type": "string" },
                    "planName": { "type": "string" },
                    "planType": { "type": "string", "enum": ["Private", "Package"] },
                    "teachers": { "type": "array", "items": { "type": "string" } },
                    "price": { "type": "number" },
                    "paid": { "type": "number" },
                    "remaining": { "type": "number" },
                    "startDate": { "type": "string", "format": "date-time" },
                    "endDate": { "type": "string", "format": "date-time" }
                },
                "required": ["subscriptionId", "planId", "planName", "price", "paid", "remaining", "startDate", "endDate"]
            }
        },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp of when the student profile was created." }
      },
      "required": ["id", "name", "phoneNumber"]
    },
    "StudentSyncData": {
        "title": "Student Sync Data",
        "type": "object",
        "description": "Minimal student data synced from a teacher's offline device for parent/student view.",
        "properties": {
            "lastCheckIn": { "type": "string", "format": "date-time", "description": "The ISO string of the last check-in time." },
            "planName": { "type": "string", "description": "The name of the plan for the last check-in." },
            "debtStatus": { "type": "number", "description": "The student's current debt amount for that plan." },
            "teacherId": { "type": "string", "description": "The ID of the teacher who synced the data." }
        },
        "required": ["lastCheckIn", "teacherId"]
    },
    "Parent": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Parent",
      "type": "object",
      "description": "Represents a parent monitoring a student.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the Parent session." },
        "phoneNumber": { "type": "string", "description": "The parent's phone number, used for identification in the parent portal." },
        "studentBarcodeId": { "type": "string", "description": "The barcode ID of the student being monitored." }
      },
      "required": ["id", "phoneNumber", "studentBarcodeId"]
    },
    "Course": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Course",
      "type": "object",
      "description": "Represents a course or video content.",
      "properties": {
        "courseId": { "type": "string", "description": "Unique identifier for the Course entity." },
        "title": { "type": "string", "description": "The title of the course." },
        "description": { "type": "string", "description": "A description of the course content." },
        "videoUrl": { "type": "string", "description": "DEPRECATED in favor of 'videos' array. The YouTube or Google Drive URL of the video.", "format": "uri" },
        "videos": {
          "type": "array",
          "description": "A collection of videos for this course.",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "description": "A unique ID for the video within the course." },
              "title": { "type": "string", "description": "The title of the video." },
              "url": { "type": "string", "description": "The URL of the video.", "format": "uri" }
            },
            "required": ["id", "title", "url"]
          }
        },
        "thumbnailUrl": { "type": "string", "description": "The URL of the course thumbnail image.", "format": "uri" },
        "attachmentUrl": { "type": "string", "description": "An optional link to a PDF or other resource.", "format": "uri" },
        "grades": { "type": "array", "description": "An array of grades for which the course is suitable.", "items": { "type": "string" } },
        "locked": { "type": "boolean", "description": "Indicates whether the course is locked and requires a share code." },
        "viewLimit": {
          "type": "number",
          "description": "The number of times a student can view this course after unlocking it. A value of 0 or undefined means unlimited views."
        },
        "teacherId": { "type": "string", "description": "Reference to Teacher. (Relationship: Teacher 1:N Course)" }
      },
      "required": ["courseId", "title", "teacherId"]
    },
    "CourseCollection": {
        "title": "Course Collection",
        "type": "object",
        "description": "A collection of courses bundled together that can be unlocked with a single code.",
        "properties": {
            "id": { "type": "string" },
            "teacherId": { "type": "string" },
            "title": { "type": "string" },
            "description": { "type": "string" },
            "courseIds": { "type": "array", "items": { "type": "string" } },
            "thumbnailUrl": { "type": "string", "format": "uri" },
            "locked": { "type": "boolean", "default": true }
        },
        "required": ["id", "teacherId", "title", "courseIds"]
    },
    "CourseAccess": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "CourseAccess",
      "type": "object",
      "description": "Represents student access to a specific course.",
      "properties": {
        "courseAccessId": { "type": "string", "description": "Unique identifier for the CourseAccess entity." },
        "courseId": { "type": "string", "description": "Reference to Course. (Relationship: Course 1:N CourseAccess)" },
        "studentId": { "type": "string", "description": "Reference to Student. (Relationship: Student 1:N CourseAccess)" },
        "viewCount": {
          "type": "number",
          "description": "The number of times the student has viewed this specific unlocked course instance."
        },
        "viewLimit": {
          "type": "number",
          "description": "The view limit for this specific unlock instance, copied from the course at the time of unlock."
        }
      },
      "required": ["courseAccessId", "courseId", "studentId"]
    },
     "CourseCollectionAccess": {
      "title": "CourseCollectionAccess",
      "type": "object",
      "description": "Represents student access to a course collection.",
      "properties": {
        "collectionId": { "type": "string" },
        "studentId": { "type": "string" },
        "unlockedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["collectionId", "studentId"]
    },
    "ShareCode": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ShareCode",
      "type": "object",
      "description": "Represents a single-use share code for unlocking a locked course or collection.",
      "properties": {
        "code": { "type": "string", "description": "The unique share code." },
        "courseId": { "type": "string", "description": "Reference to Course. (Relationship: Course 1:N ShareCode)" },
        "collectionId": { "type": "string", "description": "Reference to CourseCollection." },
        "used": { "type": "boolean", "description": "Indicates whether the share code has been used." }
      },
      "required": ["code", "used"]
    },
    "CalendarEvent": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "CalendarEvent",
      "type": "object",
      "description": "Represents an event in the teacher's calendar.",
      "properties": {
        "eventId": { "type": "string", "description": "Unique identifier for the CalendarEvent entity." },
        "teacherId": { "type": "string", "description": "The ID of the teacher this event belongs to." },
        "grade": { "type": "string", "description": "The grade level to which the event applies." },
        "startTime": { "type": "string", "description": "The start time of the event.", "format": "date-time" },
        "endTime": { "type": "string", "description": "The end time of the event.", "format": "date-time" },
        "place": { "type": "string", "description": "The location of the event (classroom or Zoom link)." },
        "title": { "type": "string", "description": "The title of the event." },
        "recurrence": { "type": "string", "description": "The recurrence pattern of the event (single, weekly, monthly)." }
      },
      "required": ["eventId", "teacherId", "grade", "startTime", "endTime", "place"]
    },
    "Announcement": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Announcement",
      "type": "object",
      "description": "Represents a temporary announcement or offer.",
      "properties": {
        "announcementId": { "type": "string", "description": "Unique identifier for the Announcement entity." },
        "text": { "type": "string", "description": "The text of the announcement." },
        "startTime": { "type": "string", "description": "The start time of the announcement.", "format": "date-time" },
        "endTime": { "type": "string", "description": "The end time of the announcement.", "format": "date-time" }
      },
      "required": ["announcementId", "text", "startTime", "endTime"]
    },
    "Assistant": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Assistant",
      "type": "object",
      "description": "Represents a teacher's assistant.",
      "properties": {
        "assistantId": { "type": "string", "description": "Unique identifier for the assistant, same as Firebase Auth UID." },
        "teacherId": { "type": "string", "description": "The ID of the teacher this assistant works for." },
        "name": { "type": "string", "description": "The assistant's name." }
      },
      "required": ["assistantId", "teacherId"]
    },
    "Subject": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Subject",
      "type": "object",
      "description": "Represents an academic subject.",
      "properties": {
        "id": { "type": "string", "description": "Unique ID for the subject." },
        "name": { "type": "string", "description": "The name of the subject." }
      },
      "required": ["id", "name"]
    },
    "Hub": {
      "title": "Hub",
      "type": "object",
      "description": "Represents a single educational hub entity which contains all related data.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "instagramUrl": { "type": "string", "format": "uri" },
        "facebookUrl": { "type": "string", "format": "uri" },
        "tiktokUrl": { "type": "string", "format": "uri" },
        "socialNote": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "EnrolledStudent": {
      "title": "EnrolledStudent",
      "type": "object",
      "description": "Represents an enrolled student in a hub. This is now merged into the main Student entity.",
      "properties": {
        "barcodeId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "notes": { "type": "string" },
        "activeSubscriptions": {
            "type": "array",
            "items": { "$ref": "#/backend/entities/StudentSubscription" }
        }
      },
      "required": ["barcodeId", "name", "phone"]
    },
    "EnrollmentPlan": {
      "title": "EnrollmentPlan",
      "type": "object",
      "description": "Represents an enrollment plan.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "description": { "type": "string" },
        "durationValue": { "type": "number" },
        "durationUnit": { "type": "string", "enum": ["days", "months"] },
        "tutor": { "type": "string" },
        "schedule": { "type": "string" },
        "grades": { "type": "array", "items": { "type": "string" } },
        "sessionDays": { "type": "array", "items": { "type": "string", "enum": ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"] } }
      },
      "required": ["id", "name", "price", "description", "durationValue", "durationUnit", "schedule", "grades"]
    },
    "Transaction": {
      "title": "Transaction",
      "type": "object",
      "description": "Represents a financial transaction.",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "planName": { "type": "string" },
        "planId": { "type": "string" },
        "duration": { "type": "string" },
        "totalPrice": { "type": "number" },
        "paidAmount": { "type": "number" },
        "remaining": { "type": "number" },
        "note": { "type": "string" },
        "type": { "type": "string", "enum": ["New Enrollment", "Extend/Payment", "Payment"] },
        "aide": { "type": "string" },
        "date": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "studentId", "studentName", "paidAmount", "type", "aide", "date", "planId"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "type": "object",
      "description": "Represents a single attendance check-in event.",
      "properties": {
        "id": { "type": "string" },
        "barcodeId": { "type": "string" },
        "checkInTime": { "type": "string", "format": "date-time" },
        "aideName": { "type": "string" },
        "studentName": { "type": "string" },
        "studentPhone": { "type": "string" },
        "planName": { "type": "string" }
      },
      "required": ["id", "barcodeId", "checkInTime", "aideName", "studentName"]
    },
    "Aide": {
      "title": "Aide",
      "type": "object",
      "description": "Represents an aide with login credentials and a role.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["S Admin", "Check-in Staff"], "description": "The role of the aide which determines their permissions." }
      },
      "required": ["id", "name", "role"]
    },
    "Offer": {
        "title": "Offer",
        "type": "object",
        "description": "Represents a limited-time offer.",
        "properties": {
            "id": { "type": "string" },
            "title": { "type": "string" },
            "endDate": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "title", "endDate"]
    },
    "RecordingOffer": {
      "title": "RecordingOffer",
      "type": "object",
      "description": "Represents a pricing offer for the recording room.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "type": { "type": "string", "enum": ["per-hour", "per-package"] },
        "videoCount": { "type": "number" }
      },
      "required": ["id", "title", "price", "type"]
    },
    "RecordingBooking": {
      "title": "RecordingBooking",
      "type": "object",
      "description": "Represents a booking request for the recording room.",
      "properties": {
        "id": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "offerId": { "type": "string" },
        "offerTitle": { "type": "string" },
        "requestedDate": { "type": "string", "format": "date" },
        "requestedTime": { "type": "string", "format": "time" },
        "status": { "type": "string", "enum": ["pending", "approved", "declined"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "teacherId", "teacherName", "offerId", "offerTitle", "requestedDate", "requestedTime", "status", "createdAt"]
    },
    "Comment": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Comment",
      "type": "object",
      "description": "Represents a comment made by a student on a course.",
      "properties": {
        "id": { "type": "string", "description": "Unique ID for the comment." },
        "studentId": { "type": "string", "description": "The ID of the student who made the comment." },
        "studentName": { "type": "string", "description": "The name of the student." },
        "text": { "type": "string", "description": "The content of the comment." },
        "createdAt": { "type": "string", "format": "date-time", "description": "The timestamp when the comment was made." }
      },
      "required": ["id", "studentId", "studentName", "text", "createdAt"]
    },
    "CanvasConfig": {
        "title": "CanvasConfig",
        "type": "object",
        "description": "Stores the configuration and data for the admin canvas/statistics page.",
        "properties": {
            "activeTeachers": { "type": "number" },
            "teacherQuota": { "type": "number" },
            "serviceTeacherCost": { "type": "number" },
            "workers": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "id": { "type": "string" },
                        "name": { "type": "string" },
                        "salary": { "type": "number" }
                    },
                    "required": ["id", "name", "salary"]
                }
            },
            "expenses": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "id": { "type": "string" },
                        "name": { "type": "string" },
                        "amount": { "type": "number" }
                    },
                    "required": ["id", "name", "amount"]
                }
            },
            "incomes": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "id": { "type": "string" },
                        "name": { "type": "string" },
                        "amount": { "type": "number" }
                    },
                    "required": ["id", "name", "amount"]
                }
            }
        }
    },
    "QuestionBank": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "QuestionBank",
      "type": "object",
      "description": "Represents a published question bank or educational file with Google Drive link.",
      "properties": {
        "id": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "grade": { "type": "string" },
        "fileUrl": { "type": "string", "format": "uri" },
        "fileName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["teacherId", "title", "grade", "fileUrl"]
    },
    "Test": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Test",
      "type": "object",
      "description": "Represents a quiz or exam created by a teacher.",
      "properties": {
        "id": { "type": "string" },
        "teacherId": { "type": "string" },
        "title": { "type": "string" },
        "testCode": { "type": "string" },
        "rulesText": { "type": "string" },
        "timeLimit": { "type": "number" },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["mcq", "true_false"] },
              "questionText": { "type": "string" },
              "questionMedia": { "type": "string" },
              "options": { "type": "array", "items": { "type": "string" } },
              "correctAnswer": { "type": ["string", "boolean"] },
              "points": { "type": "number" }
            },
            "required": ["type", "correctAnswer", "points"]
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["teacherId", "title", "testCode", "questions"]
    },
    "TestAttempt": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "TestAttempt",
      "type": "object",
      "description": "Represents a student submission of a test.",
      "properties": {
        "id": { "type": "string" },
        "testId": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "studentPhone": { "type": "string" },
        "teacherId": { "type": "string" },
        "testTitle": { "type": "string" },
        "score": { "type": "number" },
        "totalPoints": { "type": "number" },
        "submittedAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["completed", "auto_submitted_exit"] }
      },
      "required": ["testId", "studentId", "score", "totalPoints", "status"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/teachers/{teacherId}",
        "definition": { "entityName": "Teacher", "schema": { "$ref": "#/backend/entities/Teacher" }, "description": "Stores teacher profile information." }
      },
      {
        "path": "/teachers/{teacherId}/ratings/{studentId}",
