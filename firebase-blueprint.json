{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "Authenticated student profile (zero plaintext password fields stored).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "barcodeId": { "type": "string" },
        "name": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "isPhoneVerified": { "type": "boolean" },
        "university": { "type": "string" },
        "grade": { "type": "string" },
        "professorCode": { "type": "string" },
        "connectedProfessors": { "type": "array", "items": { "type": "string" } },
        "role": { "type": "string", "enum": ["student"] }
      },
      "required": ["id", "barcodeId", "name", "role"]
    },
    "Teacher": {
      "title": "Teacher",
      "description": "Private teacher account record (zero plaintext password fields stored).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "teacherCode": { "type": "string" },
        "approved": { "type": "boolean" },
        "subjects": { "type": "array", "items": { "type": "string" } },
        "gradesTaught": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "name", "email"]
    },
    "PublicTeacher": {
      "title": "PublicTeacher",
      "description": "Sanitized public discovery record for a teacher with zero PII.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "teacherCode": { "type": "string" },
        "subject": { "type": "string" },
        "coursesCount": { "type": "number" },
        "studentsCount": { "type": "number" }
      },
      "required": ["id", "name", "teacherCode"]
    },
    "User": {
      "title": "User",
      "description": "Role lookup and account index document.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["student", "teacher", "librarian", "admin"] }
      },
      "required": ["role"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Server-managed administrator grant.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "role": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["uid", "active"]
    },
    "PhoneVerification": {
      "title": "PhoneVerification",
      "description": "WhatsApp bot verification state keyed by 6-digit verification code.",
      "type": "object",
      "properties": {
        "verified": { "type": "boolean" },
        "phoneNumber": { "type": "string" }
      },
      "required": ["verified"]
    },
    "PasswordResetChallenge": {
      "title": "PasswordResetChallenge",
      "description": "Server-only temporary WhatsApp password reset session.",
      "type": "object",
      "properties": {
        "challengeId": { "type": "string" },
        "studentDocId": { "type": "string" },
        "expectedPhoneNormalized": { "type": "string" },
        "verificationCode": { "type": "string" },
        "phoneVerified": { "type": "boolean" },
        "used": { "type": "boolean" }
      },
      "required": ["challengeId", "studentDocId", "verificationCode", "used"]
    }
  },
  "firestore": {
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Owner/admin-only student profile documents."
    },
    "/teachers/{teacherId}": {
      "schema": { "$ref": "#/entities/Teacher" },
      "description": "Owner/admin-only teacher account documents."
    },
    "/public_teachers/{teacherId}": {
      "schema": { "$ref": "#/entities/PublicTeacher" },
      "description": "Sanitized public teacher catalog."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Owner/admin-only user role index."
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Server-managed administrator registry."
    },
    "/phone_verifications/{code}": {
      "schema": { "$ref": "#/entities/PhoneVerification" },
      "description": "WhatsApp bot verification docs (get by code only; list/write blocked)."
    },
    "/password_reset_challenges/{challengeId}": {
      "schema": { "$ref": "#/entities/PasswordResetChallenge" },
      "description": "Server-only WhatsApp password reset challenges."
    }
  }
}
